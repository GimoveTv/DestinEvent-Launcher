{
    "name": "DestinEvent-Launcher",
    "preductname": "DestinEvent Launcher",
    "version": "0.0.3",
    "description": "Launcher Minecraft pour le serveur Destin Event",
    "main": "src/app.js",
    "author": {
        "name": "GimoveTv",
        "email": "contact@gimove.tv",
        "url": "https://github.com/gimovetv"
    },
    "url": "https://destinevent.alwaysdata.net/",
    "scripts": {
        "start": "cross-env NODE_ENV=dev electron .",
        "dev": "cross-env DEV_TOOL=open nodemon --exec npm start",
